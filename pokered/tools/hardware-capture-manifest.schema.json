{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokered:dmg-cpu-b-hardware-capture:1",
  "title": "DMG-CPU B hardware capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "fixture",
    "environment",
    "program",
    "captureSetup",
    "runs",
    "analysis"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "DmgCpuBCommonBoot"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "consoleSerial", "socMarking", "socPhotoSha256", "mainboardRevision", "partMarkings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "consoleSerial": {"type": "string", "minLength": 1},
        "socMarking": {"const": "DMG-CPU B"},
        "packageType": {"type": "string"},
        "socPhotoSha256": {"$ref": "#/$defs/sha256"},
        "mainboardRevision": {"type": "string", "minLength": 1},
        "partMarkings": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "operator", "supplyMillivolts", "temperatureCelsius"],
      "properties": {
        "capturedAt": {"type": "string", "format": "date-time"},
        "operator": {"type": "string", "minLength": 1},
        "supplyMillivolts": {"type": "integer", "minimum": 4500, "maximum": 5500},
        "temperatureCelsius": {"type": "number", "minimum": 0, "maximum": 50},
        "notes": {"type": "string"}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256", "romSha256", "bootRomSha256", "toolchain"],
      "properties": {
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "romSha256": {"$ref": "#/$defs/sha256"},
        "bootRomSha256": {"const": "cf053eccb4ccafff9e67339d4e78e98dce7d1ed59be819d2a1ba2232c6fce1c7"},
        "toolchain": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "captureSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interposerRevision", "fpgaBitstreamSha256", "analyzer", "digitalSampleRateHz", "channels", "calibrationSha256"],
      "properties": {
        "interposerRevision": {"type": "string", "minLength": 1},
        "fpgaBitstreamSha256": {"$ref": "#/$defs/sha256"},
        "analyzer": {"type": "string", "minLength": 1},
        "digitalSampleRateHz": {"type": "integer", "minimum": 100000000},
        "analogSampleRateHz": {"type": "integer", "minimum": 100000000},
        "probeLoading": {"type": "string"},
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "PHI"}},
            {"contains": {"const": "/RD"}},
            {"contains": {"const": "/WR"}},
            {"contains": {"const": "/CS"}},
            {"contains": {"const": "RESET"}},
            {"contains": {"pattern": "^A([0-9]|1[0-5])$"}},
            {"contains": {"pattern": "^D[0-7]$"}}
          ],
          "items": {"type": "string"}
        },
        "calibrationSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "repetition", "stimulus", "rawFiles", "expectedRelation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "group": {
            "enum": ["phase", "read-fold", "reset", "halt", "stop", "interrupt", "invalid-lock", "oam-idu", "canonical-red"]
          },
          "repetition": {"type": "integer", "minimum": 1},
          "stimulus": {"type": "object"},
          "rawFiles": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/file"}
          },
          "expectedRelation": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scriptSha256", "independentAnalysisSha256", "claims"],
      "properties": {
        "scriptSha256": {"$ref": "#/$defs/sha256"},
        "independentAnalysisSha256": {"$ref": "#/$defs/sha256"},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "classification", "runIds", "statement"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "classification": {"enum": ["deterministic-fixture", "family-relation", "negative", "inconclusive"]},
              "runIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "statement": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "publicKeyId", "value"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "publicKeyId": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["vcd", "csv", "sr", "wav", "png", "json", "binary"]}
      }
    }
  }
}
