/-- The legal move pool of an internal species id (`#[]` if none). -/
def learnset (id : SpeciesId) : Array MoveId := learnPools.getD id.toNat #[]

/-- Whether `id` can legally know move `m` — pool membership, evolution-inclusive. -/
def canLearn (id : SpeciesId) (m : MoveId) : Bool := (learnset id).contains m

/-! ## Fidelity guards -/

#guard learnPools.size == 191   -- indices $00..$BE

-- Direct learnset membership (level-1, level-up, TM/HM).
#guard canLearn 153 33 && canLearn 153 45     -- BULBASAUR: TACKLE, GROWL (level 1)
#guard canLearn 153 22 && canLearn 153 76     -- BULBASAUR: VINE_WHIP (lv13), SOLARBEAM (TM)
#guard !canLearn 153 56                        -- BULBASAUR cannot learn HYDRO_PUMP

-- Evolution inheritance: Gyarados keeps Magikarp's Splash/Tackle, which are
-- absent from its own learnset.
#guard canLearn 22 150 && canLearn 22 33       -- GYARADOS inherits SPLASH, TACKLE
#guard !canLearn 133 56                         -- MAGIKARP still cannot learn HYDRO_PUMP

-- Glitch / non-species internal ids have empty pools.
#guard learnset 31 == #[] && learnset 0 == #[] && learnset 182 == #[]

end Battle.Data
